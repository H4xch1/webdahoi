const ROLE_LABELS: Record<string, string> = {
  murid: "Ruang Murid",
  guru: "Ruang Guru",
  kepsek: "Ruang Kepala Sekolah",
  kurikulum: "Ruang Kurikulum",
  admin: "Ruang Administrator",
};

export default function Sidebar({
  role,
}: SidebarProps) {
  const pathname = usePathname();
  const router = useRouter();

  const logoutLock = useRef(false);

  const [isLoggingOut, setIsLoggingOut] =
    useState(false);

  const [logoutError, setLogoutError] =
    useState("");

  const normalizedRole = role
    .trim()
    .toLowerCase();

  const roleKey =
    normalizedRole === "admin_utama"
      ? "admin"
      : normalizedRole;

  const items = NAV_BY_ROLE[roleKey] ?? [];

  const roleLabel =
    ROLE_LABELS[roleKey] ?? "Dashboard";

  const homeHref =
    items.find((item) => item.exact)?.href ?? "/";

  async function handleLogout() {
    if (logoutLock.current) {
      return;
    }

    logoutLock.current = true;

    setIsLoggingOut(true);
    setLogoutError("");

    try {
      await api.post("/auth/logout");

      router.replace("/login");
      router.refresh();
    } catch {
      setLogoutError(
        "Gagal logout. Silakan coba lagi.",
      );
    } finally {
      logoutLock.current = false;
      setIsLoggingOut(false);
    }
  }

  return (
    <aside
      className={styles.sidebar}
      aria-label={roleLabel}
    >
      <Link
        href={homeHref}
        className={styles.brand}
        aria-label={`Webdahoi — ${roleLabel}`}
      >
        <span className={styles.logo}>
          <GraduationCap
            size={25}
            aria-hidden="true"
          />
        </span>

        <span className={styles.brandText}>
          <span className={styles.brandName}>
            Webdahoi
          </span>

          <span className={styles.brandSubtitle}>
            Learning Portal
          </span>
        </span>
      </Link>

      <section
        className={styles.roleCard}
        aria-label="Peran akun"
      >
        <span
          className={styles.roleIndicator}
          aria-hidden="true"
        />

        <div>
          <p className={styles.roleCaption}>
            Area pembelajaran
          </p>

          <p className={styles.roleName}>
            {roleLabel}
          </p>
        </div>
      </section>

      <p className={styles.menuLabel}>
        Menu utama
      </p>

      <nav
        className={styles.nav}
        aria-label={`Navigasi ${roleLabel}`}
      >
        {items.map((item) => {
          const active = item.exact
            ? pathname === item.href
            : pathname === item.href ||
              pathname.startsWith(
                `${item.href}/`,
              );

          const className = [
            styles.navItem,
            active
              ? styles.navItemActive
              : "",
          ]
            .filter(Boolean)
            .join(" ");

          return (
            <Link
              key={item.href}
              href={item.href}
              aria-current={
                active ? "page" : undefined
              }
              className={className}
            >
              <span className={styles.navIcon}>
                {item.icon}
              </span>

              <span className={styles.navLabel}>
                {item.label}
              </span>

              {active && (
                <span
                  className={
                    styles.activeIndicator
                  }
                  aria-hidden="true"
                />
              )}
            </Link>
          );
        })}
      </nav>

      <footer className={styles.footer}>
        {logoutError && (
          <p
            role="alert"
            className={styles.logoutError}
          >
            {logoutError}
          </p>
        )}

        <button
          type="button"
          onClick={handleLogout}
          disabled={isLoggingOut}
          className={styles.logoutBtn}
        >
          <LogOut
            size={17}
            aria-hidden="true"
          />

          <span>
            {isLoggingOut
              ? "Logging out..."
              : "Log Out"}
          </span>
        </button>

        <p className={styles.footerText}>
          Webdahoi Learning Portal
        </p>
      </footer>
    </aside>
  );
}
