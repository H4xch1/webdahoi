{
  "package": "Webdahoi Guru motion add-on",
  "keepsExistingCinematicTheme": true,
  "newDependencies": [],
  "databaseChanges": false,
  "motion": {
    "native": "document.startViewTransition",
    "fallback": "Web Animations API entrance",
    "durationMs": 560,
    "maxSnapshotWaitMs": 220
  },
  "background": {
    "format": "animated WebP",
    "frames": 80,
    "durationMs": 6400,
    "dimensions": [
      960,
      540
    ],
    "bytes": 674250,
    "isLive2D": false
  },
  "installerModifiesWithBackups": [
    "frontend/src/app/(dashboard)/layout.tsx",
    "frontend/src/components/layout/Sidebar.tsx",
    "standard default next/link imports in Guru-folder TSX files"
  ],
  "newFiles": [
    "frontend/src/components/guru-motion/config.ts",
    "frontend/src/components/guru-motion/GuruMotionLink.tsx",
    "frontend/src/components/guru-motion/GuruMotionBoundary.tsx",
    "frontend/src/components/guru-motion/guru-motion.css",
    "tools/install-guru-motion.mjs",
    "frontend/public/themes/guru-motion/academy-poster.webp",
    "frontend/public/themes/guru-motion/academy-loop.webp",
    "preview-guru-motion/index.html",
    "preview-guru-motion/demo.css",
    "preview-guru-motion/demo.js",
    "tools/preview-guru-motion.mjs",
    "README-GURU-MOTION.md",
    "MOTION-ASSETS.txt",
    "VERIFICATION.txt"
  ]
}