{
  "package": "Guru-style role dashboards",
  "homePagesRedesigned": [
    "/admin",
    "/murid",
    "/kurikulum"
  ],
  "themeRoles": [
    "guru",
    "admin",
    "murid",
    "kurikulum",
    "kepsek"
  ],
  "prerequisite": "Installed local Guru cinematic CSS and referenced public assets",
  "newDependencies": [],
  "databaseChanges": false,
  "extendsGuruMotionRuntime": false,
  "files": [
    "frontend/src/components/role-dashboards/DashboardKit.tsx",
    "frontend/src/components/role-dashboards/AdminDashboard.tsx",
    "frontend/src/components/role-dashboards/StudentDashboard.tsx",
    "frontend/src/components/role-dashboards/CurriculumDashboard.tsx",
    "role-unification/pages/admin.tsx",
    "role-unification/pages/murid.tsx",
    "role-unification/pages/kurikulum.tsx",
    "frontend/src/components/role-dashboards/dashboards.module.css",
    "frontend/src/app/role-polish.css",
    "tools/install-role-dashboards.mjs",
    "tools/restore-role-dashboards.mjs",
    "README-ROLE-DASHBOARDS.md",
    "DESIGN-NOTES.md",
    "VERIFICATION.txt"
  ],
  "installerWrites": [
    "frontend/src/app/role-cinematic.css",
    "frontend/src/app/layout.tsx",
    "frontend/src/app/(dashboard)/admin/page.tsx",
    "frontend/src/app/(dashboard)/murid/page.tsx",
    "frontend/src/app/(dashboard)/kurikulum/page.tsx"
  ]
}